
---
const projects = [
  {
    number: "01",
    name: "Smart School Management System",
    category: "FULL STACK · AI",
    description:
      "A school management platform exploring gamified learning, role-based access, and AI-assisted educational insights.",
    tags: ["React", "TypeScript", "AI"],
  },
  {
    number: "02",
    name: "Parking Management System",
    category: "WEB APPLICATION",
    description:
      "A parking management application focused on booking workflows, management tools, and a structured web interface.",
    tags: ["Python", "Django", "Database"],
  },
  {
    number: "03",
    name: "Machine Learning Lab",
    category: "MACHINE LEARNING",
    description:
      "A space for practical experiments in data preprocessing, feature engineering, and clustering algorithms.",
    tags: ["Python", "ML", "Data"],
  },
  {
    number: "04",
    name: "RepoDoctor AI",
    category: "AI · STATIC CODE ANALYSIS",
    description:
      "An AI-powered repository analyzer that scans uploaded ZIP repositories, detects potential code issues and security risks, and recommends improvements with reviewable patches.",
    tags: ["Python", "FastAPI", "JavaScript/TypeScript", "Static Code Analysis"],
    features: [
      "ZIP-based repository scanning",
      "Multi-language code analysis",
      "Security and code-quality issue detection",
      "Severity-based findings",
      "Actionable recommendations",
      "Reviewable code patches",
    ],
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#10110f" />
    <meta
      name="description"
      content="Om Jani — AI and Full Stack Developer building practical software and intelligent applications."
    />
    <title>Om Jani — AI & Full Stack Developer</title>
  </head>

  <body>
    <header class="nav">
      <a class="brand" href="#home">OJ<span>.</span></a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact</a>
      </nav>
      <a class="nav-cta" href="#contact">Let's talk <span>↗</span></a>
    </header>

    <main>
      <section class="hero" id="home">
        <div class="hero-copy">
          <p class="eyebrow">HELLO, I'M OM JANI</p>

          <h1>
            <span class="hero-title-top">Exploring <span class="accent">AI</span></span>
            <span class="hero-title-bottom">
              Engineering real-world solutions
            </span>
          </h1>

          <p class="hero-description">
            I explore the intersection of artificial intelligence and software
            development to build practical digital experiences.
          </p>

          <div class="hero-actions">
            <a class="button button-primary" href="#projects">
              Explore my work <span>↘</span>
            </a>
            <a class="button button-secondary" href="#contact">
              Get in touch
            </a>
          </div>

          <div class="socials">
            <a href="https://github.com/janiom1" target="_blank" rel="noreferrer">GitHub ↗</a>
            <span>/</span>
            <a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
          </div>
        </div>

        <div class="hero-visual" aria-label="Decorative abstract orbital graphic">
          <div class="orbit orbit-one">
            <span class="atom atom-one" aria-hidden="true"></span>
            <span class="atom atom-two" aria-hidden="true"></span>
          </div>
          <div class="orbit orbit-two">
            <span class="orbit-dot"></span>
            <span class="atom atom-three" aria-hidden="true"></span>
          </div>
          <div class="orbit orbit-three">
            <span class="atom atom-four" aria-hidden="true"></span>
          </div>
          <div class="core"><span>OJ</span></div>
        </div>

        <div class="hero-footer">
          <a href="#about">SCROLL TO EXPLORE ↓</a>
        </div>
      </section>

      <section class="about section" id="about">
        <div class="section-heading">
          <p class="eyebrow">01 / ABOUT ME</p>
          <h2>Curious by nature.<br /><span class="muted">Builder by choice.</span></h2>
        </div>

        <div class="about-copy">
          <p>
            I'm an MSc AI student with an interest in full-stack development,
            machine learning, and building software that solves real problems.
          </p>
          <p>
            I value understanding how things work, learning through projects,
            and turning ideas into useful applications.
          </p>


<div class="skills">
  <div class="skill-group">
    <h3>Languages</h3>
    <div class="skill-tags">
      <span>Python</span>
      <span>SQL</span>
      <span>JavaScript</span>
    </div>
  </div>

  <div class="skill-group">
    <h3>AI &amp; Machine Learning</h3>
    <div class="skill-tags">
      <span>Machine Learning</span>
      <span>NumPy</span>
      <span>Pandas</span>
      <span>Scikit-learn</span>
    </div>
  </div>

  <div class="skill-group">
    <h3>Deep Learning &amp; Generative AI</h3>
    <div class="skill-tags">
      <span>Deep Learning</span>
      <span>Generative AI</span>
      <span>PyTorch</span>
    </div>
  </div>

  <div class="skill-group">
    <h3>Web Development</h3>
    <div class="skill-tags">
      <span>HTML</span>github
      <span>CSS</span>
      <span>React</span>
      <span>FastAPI</span>
    </div>
  </div>

  <div class="skill-group">
    <h3>Developer Tools</h3>
    <div class="skill-tags">
      <span>Git</span>
      <span>GitHub</span>
      <span>VS Code</span>
      <span>Google Antigravity</span>
      <span>Jupyter Notebook</span>
    </div>
  </div>
</div>

        </div>
      </section>

      <section class="projects section" id="projects">
        <div class="projects-heading">
          <div>
            <p class="eyebrow">02 / SELECTED WORK</p>
            <h2>Things I've <span class="muted">worked on.</span></h2>
          </div>
          <span class="project-count">04 PROJECTS</span>
        </div>

        <div class="project-list">
          {projects.map((project) => (
            <article class="project-card">
              <span class="project-number">{project.number}</span>
              <div class="project-content">
                <p class="project-category">{project.category}</p>
                <h3>{project.name}</h3>
                <p class="project-description">{project.description}</p>
                <div class="project-tags">
                  {project.tags.map((tag) => <span>{tag}</span>)}
                </div>
                {project.features && (
                  <ul class="project-features">
                    {project.features.map((feature) => <li>{feature}</li>)}
                  </ul>
                )}
              </div>
              <span class="project-arrow" aria-hidden="true">↗</span>
            </article>
          ))}
        </div>
        <p class="project-note">
          Project descriptions and technologies should reflect the actual work
          you've completed.
        </p>
      </section>

      <section class="contact section" id="contact">
        <p class="eyebrow">03 / GET IN TOUCH</p>
        <h2>Have an idea?<br /><span class="muted">Let's build it.</span></h2>
        <p class="contact-description">
          Looking for an AI or software development opportunity, or have a
          project in mind? I'd be glad to hear about it.
        </p>
        <a class="button button-primary" href="mailto:janiom250@gmail.com">
          Email me <span>↗</span>
        </a>
      </section>
    </main>

    <footer>
      <a class="brand" href="#home">OJ<span>.</span></a>
      <span>BUILT WITH CURIOSITY © 2026</span>
      <a href="#home">BACK TO TOP ↑</a>
    </footer>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { scroll-behavior: smooth; scroll-padding-top: 90px; }
  :global(body) {
    margin: 0;
    background: #10110f;
    color: #f0f0e9;
    font-family: Inter, "Segoe UI", sans-serif;
    -webkit-font-smoothing: antialiased;
  }
  :global(a) { color: inherit; text-decoration: none; }
  :global(a:focus-visible) { outline: 2px solid #c7f36b; outline-offset: 5px; }

  .nav {
    height: 76px; max-width: 1240px; margin: auto; padding: 0 36px;
    display: flex; align-items: center; justify-content: space-between;
    border-bottom: 1px solid #ffffff13;
  }
  .brand { font-size: 25px; font-weight: 800; letter-spacing: -2px; }
  .brand span, .accent { color: #c7f36b; }
  nav { display: flex; gap: 34px; }
  nav a, .nav-cta { font-size: 12px; color: #b1b2a9; }
  nav a:hover, .socials a:hover, footer a:hover { color: #c7f36b; }
  .nav-cta { border: 1px solid #ffffff30; padding: 11px 15px; border-radius: 3px; }
  .nav-cta span { color: #c7f36b; margin-left: 8px; }

  .hero {
    position: relative; max-width: 1240px; min-height: 620px; margin: auto;
    padding: 100px 36px 80px; display: grid;
    grid-template-columns: 1.15fr .85fr; align-items: center; gap: 24px;
  }
  .hero-copy { position: relative; z-index: 1; }
  .eyebrow {
    color: #c7f36b; font-size: 10px; font-weight: 700;
    letter-spacing: 2px; margin: 35px 0 20px;
  }
  h1 {
    font-size: clamp(45px, 6.3vw, 78px); line-height: 1.05;
    letter-spacing: -5px; margin: 0; font-weight: 650;
  }
  .hero-title-top, .hero-title-bottom { display: block; }
  .hero-title-bottom { margin-top: 4px; }
  .hero-description {
    max-width: 450px; color: #a3a49b; font-size: 14px;
    line-height: 1.9; margin: 24px 0 28px;
  }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .button {
    display: inline-flex; justify-content: center; align-items: center;
    gap: 18px; padding: 15px 18px; font-size: 12px;
    font-weight: 650; border-radius: 3px; transition: transform .2s, background .2s;
  }
  .button:hover { transform: translateY(-3px); }
  .button-primary { background: #c7f36b; color: #171a11; }
  .button-primary:hover { background: #d8ff8a; }
  .button-secondary { border: 1px solid #ffffff30; }
  .socials { display: flex; gap: 14px; align-items: center; margin-top: 36px; font-size: 11px; color: #a3a49b; }
  .socials > span { color: #52544b; }

  .hero-visual {
    min-height: 370px; position: relative; display: grid; place-items: center;
    overflow: hidden; background-image: radial-gradient(#ffffff0b 1px, transparent 1px);
    background-size: 20px 20px;
  }
  .orbit { position: absolute; width: 240px; height: 240px; border: 1px solid #c7f36b25; border-radius: 50%; }
  .orbit-one { width: 210px; height: 210px; animation: orbit-one-rotate 24s linear infinite; }
  .orbit-two {
    width: 280px; height: 150px; border-color: #ffffff22;
    animation: orbit-two-rotate 18s linear infinite;
  }
  .orbit-three {
    width: 160px; height: 290px; border-color: #c7f36b30;
    animation: orbit-three-rotate 28s linear infinite;
  }
  .core {
    width: 108px; height: 108px; display: grid; place-items: center; border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #303d22, #151811 70%);
    border: 1px solid #c7f36b70; box-shadow: 0 0 70px #c7f36b13, inset 0 0 30px #c7f36b12;
    font-size: 28px; font-weight: 800; letter-spacing: -2px; color: #c7f36b;
  }
  .orbit-dot {
    position: absolute; width: 10px; height: 10px; border-radius: 50%;
    background: #c7f36b; top: -5px; left: 50%;
    transform: translateX(-50%); box-shadow: 0 0 18px #c7f36b;
  }
  .atom {
    position: absolute; top: -5px; left: 50%; width: 10px; height: 10px;
    background: #c7f36b; border-radius: 50%;
    box-shadow: 0 0 18px #c7f36b;
    transform: translateX(-50%);
  }
  .atom::before {
    content: ""; position: absolute; width: 4px; height: 4px;
    top: 3px; left: 3px; border-radius: 50%; background: #efffc7;
    box-shadow: 0 0 9px #efffc7;
  }
  .atom::after {
    content: ""; position: absolute; inset: -4px 1px;
    border: 1px solid #ffffff25; border-radius: 50%;
    transform: rotate(55deg);
  }
  .atom-two { top: auto; bottom: -5px; }
  .hero-footer {
    position: absolute; left: 36px; right: 36px; bottom: 24px;
    display: flex; justify-content: center; gap: 15px;
    color: #77796f; font-size: 9px; letter-spacing: 1.5px;
  }
  .hero-footer a:hover { color: #c7f36b; }

  .section { max-width: 1168px; margin: auto; padding: 110px 0; }
  .about { display: grid; grid-template-columns: 1fr 1fr; gap: 70px; border-top: 1px solid #ffffff15; }
  .section-heading .eyebrow, .projects-heading .eyebrow, .contact .eyebrow { margin-top: 0; }
  h2 { font-size: clamp(34px, 4vw, 49px); letter-spacing: -2px; line-height: 1.18; margin: 0; }
  .muted { color: #77796f; }
  .about-copy > p { color: #a3a49b; font-size: 14px; line-height: 1.9; margin: 0 0 18px; }
  .skills { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 28px; }
  .skills span, .project-tags span { border: 1px solid #ffffff20; padding: 9px 12px; border-radius: 3px; font-size: 10px; color: #b7b8af; }

  .projects { border-top: 1px solid #ffffff15; }
  .projects-heading { display: flex; align-items: end; justify-content: space-between; gap: 20px; margin-bottom: 40px; }
  .project-count { font-size: 9px; letter-spacing: 1px; color: #77796f; padding-bottom: 8px; }
  .project-list { border-top: 1px solid #ffffff22; }
  .project-card {
    display: grid; grid-template-columns: 50px 1fr 30px; gap: 22px;
    padding: 30px 15px; border-bottom: 1px solid #ffffff22;
    transition: background .25s, padding .25s;
  }
  .project-card:hover { background: #ffffff05; padding-left: 22px; }
  .project-number { font-size: 11px; color: #c7f36b; padding-top: 3px; }
  .project-category { font-size: 9px; letter-spacing: 1.5px; color: #77796f; margin: 0 0 10px; }
  h3 { font-size: 21px; letter-spacing: -.5px; margin: 0 0 12px; }
  .project-description { color: #a3a49b; font-size: 12px; line-height: 1.8; max-width: 580px; margin: 0 0 18px; }
  .project-tags { display: flex; flex-wrap: wrap; gap: 7px; }
  .project-tags span { padding: 6px 9px; }
  .project-features {
    display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 7px 22px;
    color: #a3a49b; font-size: 11px; line-height: 1.6; margin: 18px 0 0;
    padding-left: 16px;
  }
  .project-features li::marker { color: #c7f36b; }
  .project-arrow { font-size: 21px; color: #c7f36b; }
  .project-note { color: #77796f; font-size: 11px; line-height: 1.8; margin-top: 22px; }

  .contact { text-align: center; border-top: 1px solid #ffffff15; }
  .contact .eyebrow { margin-bottom: 22px; }
  .contact-description { max-width: 430px; margin: 22px auto 28px; color: #a3a49b; font-size: 13px; line-height: 1.9; }
  footer {
    min-height: 82px; max-width: 1240px; margin: auto; padding: 20px 36px;
    border-top: 1px solid #ffffff15; display: flex; justify-content: space-between;
    align-items: center; gap: 15px; color: #77796f; font-size: 9px; letter-spacing: 1px;
  }

  @keyframes orbit-one-rotate {
    to { transform: rotate(360deg); }
  }
  @keyframes orbit-two-rotate {
    from { transform: rotate(-35deg); }
    to { transform: rotate(325deg); }
  }
  @keyframes orbit-three-rotate {
    from { transform: rotate(38deg); }
    to { transform: rotate(398deg); }
  }

  @media (min-width: 1240px) {
    .section { padding-left: 0; padding-right: 0; }
  }
  @media (max-width: 1230px) {
    .section { margin-left: 36px; margin-right: 36px; }
  }
  @media (max-width: 800px) {
    .hero { grid-template-columns: 1fr; padding-top: 70px; padding-bottom: 100px; }
    .hero-visual { min-height: 300px; }
    .hero-footer span:last-child { display: none; }
    .about { grid-template-columns: 1fr; gap: 30px; }
    .section { padding-top: 80px; padding-bottom: 80px; }
    h1 { letter-spacing: -3px; }
  }
  @media (max-width: 520px) {
    .nav { height: 65px; padding: 0 20px; }
    nav { gap: 14px; }
    nav a { font-size: 10px; }
    .nav-cta { display: none; }
    .hero { padding: 65px 20px 95px; }
    .hero-visual { min-height: 260px; }
    .hero-footer { left: 20px; right: 20px; font-size: 8px; }
    .section { margin-left: 20px; margin-right: 20px; }
    h2 { letter-spacing: -1.5px; }
    .projects-heading { align-items: start; flex-direction: column; }
    .project-card { grid-template-columns: 28px 1fr 16px; gap: 10px; padding: 24px 5px; }
    h3 { font-size: 18px; }
    .project-features { grid-template-columns: 1fr; }
    footer { padding: 20px; font-size: 8px; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
  }
</style>
